[Unit]
Description=Start or leave stopped the auto-retarget loop from the web control file

[Service]
Type=simple
WorkingDirectory=/media/noetix/hdd_raid_10_box/important/data/noetix_robot_data_hub
ExecStart=/media/noetix/hdd_raid_10_box/important/data/noetix_robot_data_hub/.venv-retarget/bin/python -u /media/noetix/hdd_raid_10_box/important/data/noetix_robot_data_hub/backend/scripts/auto_retarget_supervisor.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
